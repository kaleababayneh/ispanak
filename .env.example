# Gercek anahtarlar .env dosyasina yazilir; .env asla commit edilmez.
# Bu dosya yalnizca hangi degiskenlerin gerektigini gosterir.

EVDS_API_KEY=
MIA_API_KEY=

# Asagidakilerin hepsi istege baglidir; yazilmazsa kodda tanimli varsayilan kullanilir.
# DIKKAT: satiri acip degerini bos birakmak varsayilani BOS STRING ile ezer.
# Degistirmeyecekseniz satiri yorumda birakin.

# MIA_BASE_URL=https://mia.csp.kloudeks.com/v1
# MIA_CHAT_MODEL=kkbhackathon2026/Qwen3.8-27B
# MIA_EMBED_MODEL=kkbhackathon2026/Qwen3-Embedding-8B
# MIA_OCR_MODEL=kkbhackathon2026/Unlimited-OCR
# DATA_DIR=data
# LLM_TIMEOUT_S=45

# Chainlit web arayuzu (ui/app.py) icin. Ucu de bos birakilirsa arayuz
# girisi kapali kalir (login geciyor), sunucu hicbir kullaniciyi kabul etmez.
# CHAINLIT_AUTH_SECRET, "uv run chainlit create-secret" ile uretilir.
# CHAINLIT_AUTH_SECRET=
# CHAINLIT_USERNAME=
# CHAINLIT_PASSWORD=
